# Copy to .env and fill in. Never commit .env.

# Live Jev judgments (TypeSafe). Leave empty for the labeled mock adapter.
TYPESAFE_API_KEY=

# Optional: Jev model alias (default: jev-1)
JEV_MODEL=jev-1

# Live Jev judgments via OpenRouter (no TypeSafe account needed).
# Sign up at openrouter.ai, create a key at openrouter.ai/keys.
# Billed ~$0.042/1M input tokens (~$0.00003 per decision); output is free.
# If both keys are set, TYPESAFE_API_KEY wins.
OPENROUTER_API_KEY=
# Optional: pinned Jev release on OpenRouter (default: typesafe/jev-1.13).
# OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# --- Milestone 2 (Ampersand). Fill in to enable ?source=live. ---
# "Server or CLI" key from the Ampersand dashboard (NOT the "UI Library" one).
AMPERSAND_API_KEY=
# Project ID from the Ampersand dashboard project settings.
AMPERSAND_PROJECT_ID=
# Installation ID: dashboard -> Integrations -> deal-rescue-hubspot -> installation.
AMPERSAND_INSTALLATION_ID=
